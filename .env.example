DATABASE_URL=postgresql://mailgate:mailgate@localhost:5432/mailgate
PORT=3000
WORKER_ENABLED=true
LLM_PROVIDER=anthropic
LLM_BASE_URL=
LLM_MODEL=claude-opus-5
LLM_API_KEY=
# per-call timeout, must stay below LEASE_SECONDS (default 120s); SDK retries are off
LLM_TIMEOUT_MS=90000
# Local option: LLM_PROVIDER=anthropic-compatible, LLM_BASE_URL=http://localhost:11434
# (Ollama >=0.14 with a tool-capable model, e.g. LLM_MODEL=qwen3:8b)
# Groq/OpenAI option: LLM_PROVIDER=openai-compatible, LLM_API_KEY required
# LLM_MODEL must also be set (the default claude-opus-5 above is Anthropic-only)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_STRICT_OUTPUT=false (set true for providers that support strict json_schema mode)
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
AGENTMAIL_WEBHOOK_SECRET=
